// Example OpenClaw configuration fragment.
// Merge carefully into the existing openclaw.json; do not replace unrelated config.
// General inference inherits the live adaptive-model-router v2.1 chain. Do not pin
// provider/model IDs here. grok_hero remains a fixed Grok/xAI specialist service.

{
  agents: {
    entries: {
      "betta-vision-worker": {
        name: "Betta Vision Worker",
        thinkingDefault: "low",
        skills: [],
        tools: {
          profile: "minimal",
          allow: ["read", "view_image"],
          deny: ["write", "edit", "apply_patch", "exec_command", "process", "browser", "message", "gateway", "cron", "sessions_spawn"]
        }
      },

      "betta-escalation": {
        name: "Betta Exception Reviewer",
        // Restrict this agent to diagnosis/review tools where practical.
        skills: ["betta-picture-processing"]
      }
    }
  },
  tools: {
    agentToAgent: {
      enabled: true,
      allow: ["betta-vision-worker"]
    }
  }
}
