#!/bin/sh
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PYTHON="$HERE/.venv/bin/python"

if [ ! -x "$PYTHON" ]; then
  printf '%s\n' '{"status":"FAILED","code":"RUNTIME_MISSING","message":"nta-label-print Python environment is not installed"}' >&2
  exit 2
fi

exec "$PYTHON" "$HERE/scripts/nta_label_print.py" "$@"
